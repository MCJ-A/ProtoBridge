{
  "manifest_version": 3,
  "name": "Ignait Media Translator (GPU Local)",
  "version": "2.0.0",
  "description": "Captura audio y subtítulos en tiempo real por WebSocket binario/AudioWorklet usando Ignait Studio (XTTS-v2 GPU + CAM++ + Whisper) con Smart Ducking.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ignait Media Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "yt_page_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pcm_worklet.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
